  },
  {
   "i": 37,
   "bbox": [
    96.8,
    675.0,
    541.4,
    697.7
   ],
   "tipo": "texto",
   "texto": "Las espigas de estos elementos deben ser de clase de tolerancia h 13 y los agujeros de la clase H\n11 según ISO 286-2.",
