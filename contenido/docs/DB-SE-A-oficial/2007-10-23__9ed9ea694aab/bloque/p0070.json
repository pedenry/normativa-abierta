   "tipo": "formula_sospechosa",
   "texto": "Ft.Ed\nesfuerzo axil de cálculo del tornillo, al que en su caso, se añadirán las tracciones debidas al\nefecto palanca.",
   "tamano": 10.0,
   "negrita": false,
