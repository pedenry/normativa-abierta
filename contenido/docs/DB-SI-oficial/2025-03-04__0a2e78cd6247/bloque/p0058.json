   "tipo": "texto",
   "texto": "Documento Básico SI en caso de Incendio\nAnejo C. Resistencia al fuego de las estructuras de hormigón armado",
   "tamano": 8.0,
   "negrita": false
  },
  {
   "i": 1,
   "bbox": [
    300.3,
    795.2,
