   "tipo": "texto",
   "texto": "1\nLas temperaturas en una estructura de hormigón expuesta al fuego pueden obtenerse de forma ex-\nperimental o analítica.",
   "tamano": 10.0,
   "negrita": false
  },
  {
   "i": 16,
   "bbox": [
