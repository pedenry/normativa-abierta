   "tipo": "titulo",
   "texto": "4.3.3 Método simplificado para la determinación de la presión vertical admisible\nde servicio en suelos granulares",
   "tamano": 12.0,
   "negrita": true,
   "nivel": 3
  },
  {
   "i": 12,
   "bbox": [
