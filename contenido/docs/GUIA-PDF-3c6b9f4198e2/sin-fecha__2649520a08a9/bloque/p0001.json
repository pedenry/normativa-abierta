    306.1,
    652.4,
    546.8,
    676.7
   ],
   "tipo": "texto",
   "texto": "Se sellará la junta de dilatación según lo descrito en\nla Solución A2.",
   "tamano": 9.8,
   "negrita": false
  },
  {
   "i": 11,
   "bbox": [
    314.6,
