   "bbox": [
    306.1,
    769.6,
    544.3,
    793.7
   ],
   "tipo": "texto",
   "texto": "■\ngenerar una depresión en el interior del edificio po­\ntenciando la entrada de radón desde el terreno;",
   "tamano": 9.6,
   "negrita": false
  },
